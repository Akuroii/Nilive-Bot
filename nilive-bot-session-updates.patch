-+async def classify_delivery_evidence(db, op: dict) -> tuple[str, list[str]]:
-+    """Classify what is known about a delivery whose result was never recorded.
-+
-+    Four outcomes, deliberately distinct (and never "safe to refund" by age):
-+
-+    * `goods_present`       - durable, operation-linked goods exist: the delivery
-+      (at least partly) happened. Finish it or reverse it; never refund over it.
-+    * `external_unresolved` - a Discord request was started and its outcome is
-+      unknown: it may have succeeded.
-+    * `undeterminable`      - the evidence itself is unreadable.
-+    * `never_started`       - no operation-linked goods and no external effect
-+      was ever begun. Delivery left no durable trace; a refund still goes
-+      through the same goods guard as any other and is an operator decision.
-+    """
-+    raw_rb = op.get("_raw_delivery_rollback", op.get("delivery_rollback"))
-+    extras = await _op_journal_extras(db, op["op_id"])
-+    intent_kind, intent = _parse_intent(extras["delivery_intent"])
-+    if intent_kind == "malformed":
-+        return "undeterminable", ["delivery intent is unreadable"]
-+    try:
-+        reasons = await _purchase_linked_effects(db, op)
-+    except Exception as exc:
-+        return "undeterminable", [f"evidence query failed: {exc}"]
-+    intent_reasons = [r for r in reasons if r.startswith("Discord role")]
-+    goods = [r for r in reasons if not r.startswith("Discord role")]
-+    if raw_rb not in (None, ""):
-+        goods.append("a delivery rollback descriptor is present")
