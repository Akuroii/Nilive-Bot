name: tests

# Kept deliberately small and dependency-light: the dashboard's frontend
# has real test harnesses (scripts/test_*.js) that used to be run by hand
# and therefore got skipped. Anything matching the globs below runs
# automatically on every push and PR, including the branches this repo
# actually uses (main / update).

on:
  push:
    branches: [main, update, 'arena/**']
  pull_request:
  workflow_dispatch:

jobs:
  frontend:
    name: dashboard JS harnesses
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
      - name: Run harnesses
        run: bash scripts/run_js_tests.sh

  backend:
    name: python logic harnesses
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: pip
      - name: Install requirements
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
      - name: Import the bot modules (catches syntax / import-time errors)
        run: python -c "import compileall,sys;sys.exit(0 if compileall.compile_dir('.', quiet=1, maxlevels=3) else 1)"
      - name: Run harnesses
        run: |
          status=0
          for t in scripts/test_*.py; do
            echo "▶ $t"
            if timeout 600 python "$t"; then
              echo "✓ $t"
            else
              echo "✗ $t FAILED"
              status=1
            fi
            echo
          done
          exit $status
