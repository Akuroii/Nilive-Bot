{
  "version": 1,
  "purpose": "The markdown compatibility contract for Message Builder v2, step 2. Inputs only — the expected outputs live in markdown_golden.json, which is generated from the LIVE v1 module (embed-composer.js renderDiscordMarkup) and verified against it on every run. v1 is the oracle: this file plus that golden file define 'equivalent to v1'.",
  "contexts": {
    "content": "message content — markdown + tokens + emoji-only sizing (v1: renderDiscordMarkup(text, {checkEmojiOnly:true, lookups}))",
    "description": "embed description — markdown + tokens (v1: renderDiscordMarkup(text, {lookups}))",
    "fieldValue": "embed field value — markdown + tokens (v1: renderDiscordMarkup(text, {lookups}))",
    "literal": "title / author / footer / field name / button label — plain text (v1 preview: esc(text))"
  },
  "lookups": {
    "default": "rich fixture (resolved + unresolved role/channel/user, one role with a colour)",
    "empty": "same shape, nothing resolvable"
  },
  "cases": [
    { "id": "esc-01", "category": "escaping", "input": "plain text with no markup" },
    { "id": "esc-02", "category": "escaping", "input": "<script>alert(1)</script>" },
    { "id": "esc-03", "category": "escaping", "input": "a & b" },
    { "id": "esc-04", "category": "escaping", "input": "\"double\" and 'single' quotes" },
