    { "id": "esc-06", "category": "escaping", "input": "&amp; already escaped entity" },
    { "id": "esc-07", "category": "escaping", "input": "<img src=x onerror=alert(1)>" },
    { "id": "esc-08", "category": "escaping", "input": "</div></a>", "note": "closing tags must not break the surrounding markup" },
    { "id": "esc-09", "category": "escaping", "input": "<!-- comment -->" },
