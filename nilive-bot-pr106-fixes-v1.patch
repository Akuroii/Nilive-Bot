+async def reconcile_delivery_intents(
+        bot=None, *, settle_seconds: int = INTENT_SETTLE_SECONDS,
+        lease_minutes: int = STRANDED_DELIVERY_LEASE_MINUTES,
+        limit: int = 100) -> dict:
+    """Observe the live Discord state of unresolved role-grant intents.
+
+    Observation only - this never grants or removes a role and never moves
+    money. It moves an intent to `absent` (unblocking a refund) only when an
+    authoritative fetch shows the role missing, and only after the request is
+    old enough that it can no longer be merely in flight. A role that IS present
+    is recorded as `present` and keeps the refund blocked: it may be the
+    purchase's role or one the member holds independently, and the database
+    cannot tell which. Resolving that is an explicit operator decision.
+    """
+    stats = {"settled": 0, "present": 0, "kept": 0, "errors": 0}
+    if bot is None:
+        return stats
+    async with aiosqlite.connect(DB_PATH) as db:
+        cursor = await db.execute(
+            "SELECT op_id, status, updated_at, delivery_intent "
+            "FROM shop_purchase_operations WHERE delivery_intent IS NOT NULL "
+            "AND delivery_intent != '' AND status IN (?, ?, ?) "
+            "AND COALESCE(refunded, 0) = 0 ORDER BY updated_at ASC LIMIT ?",
+            (PURCHASE_UNCERTAIN, PURCHASE_FAILED, PURCHASE_DELIVERING,
+             int(limit) * 5))
+        rows = await cursor.fetchall()
+        cursor = await db.execute(
+            "SELECT datetime('now', ?)", (f"-{int(lease_minutes)} minutes",))
+        lease_cutoff = (await cursor.fetchone())[0]
+    now = utcnow()
+    handled = 0
+    for op_id, status, updated_at, raw in rows:
+        kind, intent = _parse_intent(raw)
+        if kind != "ok" or intent.get("kind") != INTENT_KIND_DISCORD_ROLE:
+            continue
+        if intent.get("state") not in (INTENT_STARTED, INTENT_PRESENT):
+            continue
+        if handled >= limit:
+            break
+        if status == PURCHASE_DELIVERING and (
+                is_live_delivery(op_id) or str(updated_at) > str(lease_cutoff)):
+            stats["kept"] += 1
+            continue
+        started = parse_time(intent.get("started_at"))
+        if started is None or (now - started).total_seconds() < settle_seconds:
+            stats["kept"] += 1
+            continue
+        handled += 1
+        try:
+            verdict, reason = await _observe_role_presence(
+                bot, intent["guild_id"], intent["user_id"], intent["role_id"])
+        except Exception as exc:
+            stats["errors"] += 1
+            print(f"[SHOP] Role intent observation failed for {op_id}: {exc}")
+            continue
+        if verdict == "unknown":
+            stats["kept"] += 1
+            continue
+        target = INTENT_ABSENT if verdict == "absent" else INTENT_PRESENT
+        if target == intent.get("state"):
+            stats["kept"] += 1
+            continue
+        if await settle_delivery_intent(
+                op_id, target, note=f"observed {verdict}: {reason}",
+                only_from=(INTENT_STARTED, INTENT_RECORDED, INTENT_PRESENT)):
+            stats["settled" if target == INTENT_ABSENT else "present"] += 1
     return stats
 
 
