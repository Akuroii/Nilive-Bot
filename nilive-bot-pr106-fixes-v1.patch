+async def reconcile_stranded_deliveries(
+        *, lease_minutes: int = STRANDED_DELIVERY_LEASE_MINUTES,
+        limit: int = 100) -> dict:
+    """Park `delivering` operations whose worker is presumed dead.
+
+    A `delivering` row is owned by exactly one live delivery. It is "stranded"
+    only when ALL of: older than the lease (measured from when delivery was
+    claimed or last made progress), not a live delivery in this process, and
+    still wholly uncompensated. A stranded row moves to `uncertain` with the
+    classification written into `detail`. It is NEVER refunded here: money is
+    only returned by the guarded operator/`failed` paths, which re-check goods.
+    """
+    stats = {"parked": 0, "skipped_live": 0, "errors": 0,
+             "by_class": {}}
+    async with aiosqlite.connect(DB_PATH) as db:
+        cursor = await db.execute(
+            "SELECT op_id FROM shop_purchase_operations WHERE status=? "
+            "AND updated_at <= datetime('now', ?) ORDER BY updated_at ASC LIMIT ?",
+            (PURCHASE_DELIVERING, f"-{int(lease_minutes)} minutes", int(limit)))
+        candidates = [r[0] for r in await cursor.fetchall()]
+    for op_id in candidates:
+        if is_live_delivery(op_id):
+            stats["skipped_live"] += 1
+            continue
+        try:
+            async with aiosqlite.connect(DB_PATH) as db:
+                await db.execute("BEGIN IMMEDIATE")
+                try:
+                    cursor = await db.execute(
+                        "SELECT op_id, guild_id, user_id, item_id, item_name, "
+                        "status, delivery_rollback FROM shop_purchase_operations "
+                        "WHERE op_id=?", (op_id,))
+                    row = await cursor.fetchone()
+                    if not row or row[5] != PURCHASE_DELIVERING:
+                        await db.execute("ROLLBACK")
+                        continue
+                    op = {"op_id": row[0], "guild_id": row[1], "user_id": row[2],
+                          "item_id": row[3], "item_name": row[4],
+                          "delivery_rollback": row[6]}
+                    code, why = await classify_delivery_evidence(db, op)
+                    detail = (f"Stranded delivering ({code}): " + "; ".join(why)
+                              + " | parked for operator review, not refunded")
+                    won = await claim_purchase_transition(
+                        op_id, from_statuses=(PURCHASE_DELIVERING,),
+                        to_status=PURCHASE_UNCERTAIN, detail=detail[:1500],
+                        require_uncompensated=True, db=db)
+                    if won:
+                        await db.commit()
+                        stats["parked"] += 1
+                        stats["by_class"][code] = stats["by_class"].get(code, 0) + 1
+                    else:
+                        await db.execute("ROLLBACK")
+                except Exception:
+                    try:
+                        await db.execute("ROLLBACK")
+                    except Exception:
+                        pass
+                    raise
+        except Exception as exc:
+            stats["errors"] += 1
+            print(f"[SHOP] Could not park stranded delivery {op_id}: {exc}")
+    return stats
+
