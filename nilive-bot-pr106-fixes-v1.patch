+    """Journal a Discord role grant BEFORE sending it, then deliver.
+
+    A role request that times out, is cancelled, or loses its process may have
+    been applied by Discord anyway. The write-ahead intent is what lets the
+    refund guard and the reconciler treat that as unresolved instead of absent.
+    Only a delivery that reports a CERTAIN failure marks the intent absent.
+    """
+    itype = kwargs.get("itype")
+    role_id = kwargs.get("role_id")
+    op_id = kwargs.get("op_id")
+    wrote = False
+    if itype in ("role", "temp_role") and role_id and op_id:
+        present_before = None
+        try:
+            guild = interaction.guild
+            member = guild.get_member(int(kwargs["user_id"])) if guild else None
+            role = guild.get_role(int(role_id)) if guild else None
+            if member is not None and role is not None:
+                present_before = role in member.roles
+        except Exception:
+            present_before = None
+        try:
+            outcome = await begin_delivery_intent(
+                str(op_id), kind=INTENT_KIND_DISCORD_ROLE,
+                guild_id=int(kwargs["guild_id"]), user_id=int(kwargs["user_id"]),
+                role_id=int(role_id), role_present_before=present_before)
+        except Exception as exc:
+            # Nothing was sent to Discord: a certain, compensable failure.
+            return {"success": False, "expires_at": None, "warning": None,
+                    "detail": None, "boost_expires_at": None, "uncertain": False,
+                    "entry_key": None,
+                    "error": f"Could not journal the role grant: {exc}"}
+        if outcome == "refused":
+            return {"success": False, "expires_at": None, "warning": None,
+                    "detail": None, "boost_expires_at": None, "uncertain": False,
+                    "entry_key": None,
+                    "error": "Purchase is no longer deliverable."}
+        wrote = outcome == "written"
+    result = await _deliver_purchase_effects(interaction, **kwargs)
