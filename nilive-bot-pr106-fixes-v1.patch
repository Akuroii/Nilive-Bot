+async def _observe_role_presence(bot, guild_id: int, user_id: int,
+                                 role_id: int) -> tuple[str, str]:
+    """`("present"|"absent"|"unknown", reason)` from an AUTHORITATIVE fetch.
+
+    The member cache is not trusted: it can lag the API in either direction.
+    """
+    guild = bot.get_guild(int(guild_id)) if bot is not None else None
+    if guild is None:
+        return "unknown", "guild not available"
+    try:
+        member = await guild.fetch_member(int(user_id))
+    except discord.NotFound as exc:
+        if getattr(exc, "code", None) == 10007:  # Unknown Member
+            return "absent", "member is no longer in the guild"
+        return "unknown", f"not found (code {getattr(exc, 'code', None)})"
+    except Exception as exc:
+        return "unknown", f"member fetch failed: {type(exc).__name__}: {exc}"
+    held = {int(getattr(r, "id", r)) for r in (getattr(member, "roles", None) or ())}
+    return ("present" if int(role_id) in held else "absent"), "fetched member"
+
